# PostgreSQL
POSTGRES_DB=fxpos
POSTGRES_USER=fxpos
POSTGRES_PASSWORD=fxpos_password
DATABASE_URL=postgresql://fxpos:fxpos_password@db:5432/fxpos?schema=public

# Base ledger currency (your local currency)
BASE_CURRENCY_CODE=MVR

# API
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# Optional: Cloudflared tunnel token (if you use it)
CLOUDFLARED_TOKEN=
